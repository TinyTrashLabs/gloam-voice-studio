.build/
build/
.DS_Store
xcuserdata/
GloamVoiceStudio.xcodeproj/
build-app/

# Private working docs (brainstorming specs / implementation plans) — not published
docs/superpowers/

# Local Claude Code / Tiny Trash Labs tooling config — machine-specific bits stay local.
# Exception: project skills are published (portable build/run knowledge, no secrets).
# settings.json (local paths), the task lock, and output-styles are NOT published.
.claude/*
!.claude/skills/
CLAUDE.md

# App Store build/signing config (Apple Team ID, Infisical org details) — local-only, not published
app-build.config.json
secrets/
fastlane/
ExportOptions.plist

# Added by ios-android-builder setup-credentials.sh — never commit credentials
*.p8
*.jks
*.keystore
**/key.properties

# Fetched TTS model weights — hundreds of MB, re-fetchable via scripts/fetch-*.sh
Models/pocket-tts/

# asc CLI credentials (App Store Connect API key material) — never commit
.asc/

# Agent tooling scratch output (Playwright MCP traces, task reports) — not project content
.playwright-mcp/
.superpowers-task-report.md

# Local voice-pack backups
packs/*.bak-*

# Stray marketing captures
mc-*.png

# Handoffs are internal working notes — they do not belong in a public repo.
# Keep them in handoffs/ locally; see CLAUDE.md.
HANDOFF*.md
handoffs/

# `swift package edit` override — a local symlink to a sibling checkout.
# Machine-specific; never committed.
Packages/
