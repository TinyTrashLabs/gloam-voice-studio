From 3c680da8b2e6aacdceee6f8d825043d1ca5d41c2 Mon Sep 17 00:00:00 2001
From: David Freeman <david@tinytrashlabs.com>
Date: Tue, 21 Jul 2026 22:10:43 -0400
Subject: [PATCH 01/12] build(engine): pin mlx-audio-swift to the SuperTonic
 fork head

Repin TinyTrashLabs/mlx-audio-swift to 8b669540 (feat/supertonic head,
fork PR #5) which adds the native-MLX SuperTonic 3 model dispatched by
config model_type "supertonic". Graph resolves cleanly; the shared
mlx-swift-lm pin (09deb8c4) is unchanged and still agrees between Gloam
and the fork.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 Package.resolved | 4 ++--
 Package.swift    | 4 +++-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/Package.resolved b/Package.resolved
index 4e1c77f1..c170bbac 100644
--- a/Package.resolved
+++ b/Package.resolved
@@ -1,5 +1,5 @@
 {
-  "originHash" : "6d0662c0b195d403e6280f31395bef523feab7792bcb36257b15436d7ff16946",
+  "originHash" : "1a25e43fc3ddbd87996bb82d130d7b0485f156760637366cb8d54865bea5c4c2",
   "pins" : [
     {
       "identity" : "async-http-client",
@@ -33,7 +33,7 @@
       "kind" : "remoteSourceControl",
       "location" : "https://github.com/TinyTrashLabs/mlx-audio-swift.git",
       "state" : {
-        "revision" : "00d93dfba543f4bb26004e6acae597188ac8b947"
+        "revision" : "8b669540eb617ca24f7a4d29ea5aa6ee5e1baf4a"
       }
     },
     {
diff --git a/Package.swift b/Package.swift
index 1d5faf4a..94a1262b 100644
--- a/Package.swift
+++ b/Package.swift
@@ -17,9 +17,11 @@ let package = Package(
         // T3 token cap on the reference-clip path so a high-exaggeration line can't
         // run away past EOS (PR #3). See TinyTrashLabs/mlx-audio-swift and
         // docs/chatterbox-quality-todo.md.
+        // Pinned to the feat/supertonic head (TinyTrashLabs/mlx-audio-swift#5) which
+        // adds the native-MLX SuperTonic 3 model (model_type "supertonic").
         .package(
             url: "https://github.com/TinyTrashLabs/mlx-audio-swift.git",
-            revision: "00d93dfba543f4bb26004e6acae597188ac8b947"),
+            revision: "8b669540eb617ca24f7a4d29ea5aa6ee5e1baf4a"),
         .package(url: "https://github.com/ml-explore/mlx-swift.git", .upToNextMajor(from: "0.30.6")),
         // Pinned to the commit that merges upstream #390 (the Gemma4 VLM
         // kvSharedOnly fix so QAT checkpoints — gemma-4-e2b/e4b — load; our own
