 App/ChatController.swift     |  2 +-
 App/Views/ContentView.swift  |  2 +-
 App/Views/SettingsView.swift | 21 ++++++++++------
 4 files changed, 47 insertions(+), 27 deletions(-)

diff --git a/App/AppModel.swift b/App/AppModel.swift
index e2c64317..f3debd23 100644
--- a/App/AppModel.swift
+++ b/App/AppModel.swift
@@ -95,7 +95,7 @@ final class AppModel {
             scheduleServerSync()
             // Surface the license prompt the moment an unacknowledged backend is
             // picked — not just when Generate/Load later hits it as an error.
-            if backend.spec.needsLicenseAck && !didAckFishLicense {
